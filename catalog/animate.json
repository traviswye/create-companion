{
  "id": "animate",
  "name": "Adobe Animate",
  "kind": "app",
  "category": "Creative",
  "match": {
    "windows_exe": [
      "Animate.exe"
    ],
    "macos_bundle": [
      "com.adobe.Animate"
    ],
    "window_title": []
  },
  "sources": [
    "https://helpx.adobe.com/animate/desktop/introduction-to-animate/animate-keyboard-shortcuts.html",
    "https://helpx.adobe.com/animate/desktop/workspace-and-workflow/keyboard-shortcuts.html"
  ],
  "note": "Every row of Adobe's \"Adobe Animate keyboard shortcuts\" page, whose five tables (File, View, Windows, Edit and modify, Miscellaneous actions) are used as the context. That page draws each key as a small image rather than as text, so the chords here are read from the image file names; two of those names are Adobe's own typos or house spellings and are written out in the ordinary way: \"DOWN-ARROE\" is the Down Arrow key and \"Left-Big-Bracket\" is the [ key. Command names keep Adobe's wording, including the lower-case start of \"suppresses highlighting of selected items\" and the trailing ellipsis dropped from \"Import Image/Sound/etc...\". Two rows are left out because they are mouse gestures: increasing the onion skin marker size and shifting the onion skin range, both Ctrl-drag or Shift-drag. helpx.adobe.com/animate/using/keyboard-shortcuts.html redirects to the workspace page, which explains how to customise shortcuts and lists none of its own.",
  "actions": [
    {
      "name": "Import Image/Sound/etc",
      "context": "File",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+R"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+R"
      }
    },
    {
      "name": "Export Movie",
      "context": "File",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Alt+Shift+S"
      },
      "mac": {
        "type": "keys",
        "chord": "Alt+Shift+Cmd+S"
      }
    },
    {
      "name": "Open as Library",
      "context": "File",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+O"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+Cmd+O"
      }
    },
    {
      "name": "View movie at 100% size",
      "context": "View",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+1"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+1"
      }
    },
    {
      "name": "Show Frame",
      "context": "View",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+2"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+2"
      }
    },
    {
      "name": "Show All",
      "context": "View",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+3"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+3"
      }
    },
    {
      "name": "Show/Hide Library",
      "context": "Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+L"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+L"
      }
    },
    {
      "name": "Comment selection",
      "context": "Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+M"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+M"
