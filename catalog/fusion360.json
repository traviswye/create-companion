{
  "id": "fusion360",
  "name": "Autodesk Fusion 360",
  "kind": "app",
  "category": "CAD / 3D",
  "match": {
    "windows_exe": [
      "Fusion360.exe"
    ],
    "macos_bundle": [
      "com.autodesk.fusion360"
    ],
    "window_title": []
  },
  "sources": [],
  "note": "hand-authored 2026-09-04; expand from official documentation",
  "actions": [
    {
      "name": "Zoom in",
      "context": "",
      "windows": {
        "type": "scroll",
        "direction": "up",
        "lines": 1
      },
      "mac": {
        "type": "scroll",
        "direction": "up",
        "lines": 1
      }
    },
    {
      "name": "Zoom out",
      "context": "",
      "windows": {
        "type": "scroll",
        "direction": "down",
        "lines": 1
      },
      "mac": {
        "type": "scroll",
        "direction": "down",
        "lines": 1
      }
    },
    {
      "name": "Fit view",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "F6"
      },
      "mac": {
        "type": "keys",
        "chord": "F6"
      }
    },
    {
      "name": "Undo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    {
      "name": "Redo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Y"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Y"
      }
    },
    {
      "name": "Sketch",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "S"
      },
      "mac": {
        "type": "keys",
        "chord": "S"
      }
    },
    {
      "name": "Extrude",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "E"
      },
      "mac": {
        "type": "keys",
        "chord": "E"
      }
    },
    {
      "name": "Measure",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "I"
      },
      "mac": {
        "type": "keys",
        "chord": "I"
      }
    },
    {
      "name": "Hide / show",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "V"
      },
      "mac": {
        "type": "keys",
        "chord": "V"
      }
    },
    {
      "name": "Display mode",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Alt+V"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Alt+V"
      }
    }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Zoom in",
      "action": {
        "type": "scroll",
        "direction": "up",
        "lines": 1
      },
      "accel": "light"
    },
    "TUNE_CCW": {
      "name": "Zoom out",
      "action": {
        "type": "scroll",
        "direction": "down",
        "lines": 1
      },
      "accel": "light"
    },
    "TUNE_TAP_1F": {
      "name": "Fit view",
      "action": {
        "type": "keys",
        "chord": "F6"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Undo",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Redo",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Y"
      }
    }
  }
}
