{
  "id": "bitwarden",
  "name": "Bitwarden",
  "kind": "app",
  "category": "Productivity",
  "match": {
    "windows_exe": [
      "Bitwarden.exe"
    ],
    "macos_bundle": [
      "com.bitwarden.desktop"
    ],
    "window_title": []
  },
  "sources": [
    "https://bitwarden.com/help/keyboard-shortcuts/"
  ],
  "note": "Covers the Bitwarden desktop app plus the browser-extension shortcuts the source page documents (same keys, listed separately by Bitwarden). Skipped as not expressible: macOS full-screen mode ('Fn+F', Fn is not a supported modifier in this grammar); 'Autofill the last used card' and 'Autofill the last used identity' (the source says these require the user to create a custom shortcut, no default given); 'Always keep on top: press again to undo the action' and 'Reload' are already single toggles, no separate chord needed.",
  "actions": [
    {
      "name": "Activate the extension",
      "context": "Browser extension",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Y"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+Y"
      }
    },
    {
      "name": "Generate a password and copy it to the clipboard",
      "context": "Browser extension",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+9"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+9"
      }
    },
    {
      "name": "Lock the vault (browser extension)",
      "context": "Browser extension",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+N"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+N"
      }
    },
    {
      "name": "Autofill the last used login for the current website",
      "context": "Browser extension",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+L"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+L"
      }
    },
    {
      "name": "Lock the vault",
      "context": "General",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+L"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+L"
      }
    },
    {
      "name": "Open Bitwarden preferences",
      "context": "General",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+,"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+,"
      }
    },
    {
      "name": "Reload the Bitwarden desktop app",
      "context": "General",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+R"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+R"
      }
    },
    {
      "name": "Quit the Bitwarden desktop app",
      "context": "General",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Q"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Q"
      }
    },
    {
      "name": "Place the cursor in the vault's search box",
      "context": "General",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+F"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+F"
      }
    },
    {
      "name": "Open the Bitwarden generator",
      "context": "General",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+G"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+G"
      }
    },
    {
      "name": "Add a new login",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+N"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+N"
      }
    },
    {
      "name": "Undo the last action when editing an item",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Z"
      }
    },
    {
      "name": "Redo the last action from editing an item",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Y"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Y"
      }
    },
    {
      "name": "Select all text in the active field or item",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+A"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+A"
      }
    },
    {
      "name": "Cut the selected text and copy it",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+X"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+X"
      }
    },
    {
      "name": "Copy the selected text",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+C"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+C"
      }
    },
    {
      "name": "Paste the last copied text",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+V"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+V"
      }
    },
    {
      "name": "Copy the open item's username",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+U"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+U"
      }
    },
    {
      "name": "Copy the open item's password",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+P"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+P"
      }
    },
    {
      "name": "Copy the open item's TOTP",
      "context": "Edit items",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+T"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+T"
      }
    },
    {
      "name": "Zoom in",
      "context": "Adjust display",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+="
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+="
      }
    },
    {
      "name": "Zoom out",
      "context": "Adjust display",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+-"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+-"
      }
    },
    {
      "name": "Reset the zoom level",
      "context": "Adjust display",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+0"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+0"
      }
    },
    {
      "name": "Enter full-screen mode",
      "context": "Adjust display",
      "windows": {
        "type": "keys",
        "chord": "F11"
      }
    },
    {
      "name": "Minimize the Bitwarden desktop app",
      "context": "Control window",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+M"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+M"
      }
    },
    {
      "name": "Hide Bitwarden desktop app in the tray",
      "context": "Control window",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+M"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+M"
      }
    },
    {
      "name": "Always keep the Bitwarden desktop app on top",
      "context": "Control window",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+T"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+T"
      }
    },
    {
      "name": "Close the Bitwarden desktop app window",
      "context": "Control window",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+W"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+W"
      }
    }
  ],
  "defaults": {
    "TUNE_TAP_1F": {
      "name": "Lock the vault",
      "action": {
        "type": "keys",
        "chord": "Ctrl+L"
      }
    }
  }
}
