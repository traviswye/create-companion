  "sources": [
    "https://help.clip-studio.com/en-us/manual_en/780_shortcuts/780_shortcuts.htm",
    "https://help.clip-studio.com/en-us/manual_en/780_shortcuts/Menu_Shortcuts.htm",
    "https://help.clip-studio.com/en-us/manual_en/780_shortcuts/Tool_Shortcuts.htm",
    "https://help.clip-studio.com/en-us/manual_en/780_shortcuts/Optional_Shortcuts.htm",
    "https://help.clip-studio.com/en-us/manual_en/780_shortcuts/Shortcuts_usable_during_operation.htm",
    "https://help.clip-studio.com/en-us/manual_en/720_preferences/Shortcut_Settings.htm",
    "https://help.clip-studio.com/en-us/manual_en/720_preferences/Modifier_Key_Settings.htm"
