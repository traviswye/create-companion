      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "C" }
    }
  ],
  "defaults": {
    "TUNE_TAP_1F": {
      "name": "Focus on selected object",
      "action": { "type": "keys", "chord": "F" }
    }
  }
}
