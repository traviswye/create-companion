      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "F7" }
    },
    {
      "name": "Move selected node up",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "Up" }
    },
    {
      "name": "Move selected node down",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "Down" }
    },
    {
      "name": "Move selected node left",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "Left" }
    },
    {
      "name": "Move selected node right",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "Right" }
    },
    {
      "name": "Delete selected nodes",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "Delete" }
    },
    {
      "name": "Rename node / edit comment",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "F2" }
    },
    {
      "name": "Toggle breakpoint",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "F9" }
    },
    {
      "name": "Clear all breakpoints",
      "context": "Blueprint Editor",
      "windows": { "type": "keys", "chord": "Ctrl+Shift+F9" }
    },
    {
