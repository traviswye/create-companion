      "action": {
        "type": "keys",
        "chord": "Alt+Right"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Make everything on the page bigger (zoom in)",
      "action": {
        "type": "keys",
        "chord": "Ctrl+="
      }
    },
