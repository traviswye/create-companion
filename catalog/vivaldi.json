  "defaults": {
    "TUNE_CW": {
      "name": "Jump to the next open tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      },
      "accel": "light"
    },
    "TUNE_CCW": {
      "name": "Jump to the previous open tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      },
      "accel": "light"
    },
    "TUNE_TAP_1F": {
      "name": "Open a new tab, and jump to it",
      "action": {
        "type": "keys",
        "chord": "Ctrl+T"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Go back",
      "action": {
        "type": "keys",
        "chord": "Alt+Left"
      }
    },
    "TUNE_SWIPE_RIGHT": {
