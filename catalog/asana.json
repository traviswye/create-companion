    { "name": "Complete selected task(s)", "context": "Tasks", "windows": { "type": "keys", "chord": "Ctrl+Enter" }, "mac": { "type": "keys", "chord": "Cmd+Enter" } },
    { "name": "Open task details", "context": "Tasks", "windows": { "type": "sequence", "chords": ["Tab", "Enter"] }, "mac": { "type": "sequence", "chords": ["Tab", "Enter"] } },
    { "name": "Close task details", "context": "Tasks", "windows": { "type": "keys", "chord": "Esc" }, "mac": { "type": "keys", "chord": "Esc" } },
