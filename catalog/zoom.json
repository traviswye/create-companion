{
  "id": "zoom",
  "name": "Zoom Workplace",
  "kind": "app",
  "category": "Communication",
  "match": {
    "windows_exe": ["Zoom.exe"],
    "macos_bundle": ["us.zoom.xos"],
    "window_title": []
  },
  "sources": [
    "https://support.zoom.com/hc/en/article?id=zm_kb&sysparm_article=KB0067050"
  ],
  "note": "From the official 'Using hot keys and keyboard shortcuts' support article (support.zoom.com), current as of 2026-09. Windows and macOS sections only, per task scope; the article's Linux, iOS, and Web App sections were not used. The article documents Windows and Mac shortcuts under separate headings (Meeting, Chat, Phone, Clips, General) that don't always list the same action on both platforms, or place a given action under the same heading on both platforms (e.g. some chat-panel shortcuts appear under 'Meeting' on Windows but under 'Chat' on Mac) -- entries are matched by function where the vendor clearly intends the same command, and left platform-only where no equivalent is documented, following the vendor's own section placement for 'context'. 'Meeting'-heading actions that operate on the app before/outside a call (Join meeting, Start meeting, Schedule meeting, Screen share using direct share -- all Mac-only) are given context '' rather than 'In a meeting' since they are not in-call commands. Skipped as not expressible in the chord grammar: 'Change focus to Zoom Meeting controls' (Windows, Ctrl+Alt+Shift with no non-modifier key) and 'Toggle Always show meeting controls' on Windows (Alt alone, no non-modifier key) -- both are modifier-only combinations (the Mac equivalent of the latter, Ctrl+\\, IS expressible and is included); 'Switch to specified product tab' (Windows Ctrl+1-8, Mac Cmd+1-8), which is a range of per-tab shortcuts rather than one fixed chord. 'Press and hold to temporarily unmute' (Mac, Space) is documented as a push-to-talk hold, not a toggle tap, but is included since a bare key chord is expressible; it also requires a separate Zoom Web App setting to be enabled and only that setting's web-app behavior is described in the source, not the desktop app's -- included here as documented for the desktop Meeting section. Mac 'Phone' shortcuts use the literal Control key (not Command) per the vendor's own table. Duplicate-looking rows across two sections (e.g. 'Focus list of chats' under Meeting vs 'Focus to list of all chats and channels' under Chat, both Ctrl+L on Windows) are kept as separate actions with distinct context, matching the vendor's own section structure.",
  "actions": [
    { "name": "Join meeting", "context": "", "mac": { "type": "keys", "chord": "Cmd+J" } },
    { "name": "Start meeting", "context": "", "mac": { "type": "keys", "chord": "Cmd+Ctrl+V" } },
    { "name": "Schedule meeting", "context": "", "mac": { "type": "keys", "chord": "Cmd+D" } },
    { "name": "Screen share using direct share", "context": "", "mac": { "type": "keys", "chord": "Cmd+Ctrl+S" } },

    { "name": "View previous page of video participants", "context": "In a meeting", "windows": { "type": "keys", "chord": "PageUp" }, "mac": { "type": "keys", "chord": "Ctrl+P" } },
    { "name": "View next page of video participants", "context": "In a meeting", "windows": { "type": "keys", "chord": "PageDown" }, "mac": { "type": "keys", "chord": "Ctrl+N" } },
    { "name": "Switch to Speaker view", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+F1" } },
    { "name": "Switch to Gallery view", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+F2" } },
    { "name": "Switch between speaker, multi-speaker, and gallery view", "context": "In a meeting", "mac": { "type": "keys", "chord": "Cmd+Shift+W" } },
    { "name": "Start/stop video", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+V" }, "mac": { "type": "keys", "chord": "Cmd+Shift+V" } },
    { "name": "Mute/unmute audio", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+A" }, "mac": { "type": "keys", "chord": "Cmd+Shift+A" } },
    { "name": "Mute audio for everyone except host", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+M" }, "mac": { "type": "keys", "chord": "Cmd+Ctrl+M" } },
    { "name": "Unmute audio for everyone except host", "context": "In a meeting", "mac": { "type": "keys", "chord": "Cmd+Ctrl+U" } },
    { "name": "Press and hold to temporarily unmute", "context": "In a meeting", "mac": { "type": "keys", "chord": "Space" } },
    { "name": "Start/stop screen share", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+S" }, "mac": { "type": "keys", "chord": "Cmd+Shift+S" } },
    { "name": "Show/hide windows and applications available to share", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+S" } },
    { "name": "Pause or resume screen share", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+T" }, "mac": { "type": "keys", "chord": "Cmd+Shift+T" } },
    { "name": "Start/stop computer recording", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+R" }, "mac": { "type": "keys", "chord": "Cmd+Shift+R" } },
    { "name": "Start/stop cloud recording", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+C" }, "mac": { "type": "keys", "chord": "Cmd+Shift+C" } },
    { "name": "Pause/resume recording", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+P" }, "mac": { "type": "keys", "chord": "Cmd+Shift+P" } },
    { "name": "Switch camera", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+N" }, "mac": { "type": "keys", "chord": "Cmd+Shift+N" } },
    { "name": "Enter or exit full screen mode", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+F" }, "mac": { "type": "keys", "chord": "Cmd+Shift+F" } },
    { "name": "Switch to minimal window", "context": "In a meeting", "mac": { "type": "keys", "chord": "Cmd+Shift+M" } },
    { "name": "Show/hide in-meeting chat panel", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+H" }, "mac": { "type": "keys", "chord": "Cmd+Shift+H" } },
    { "name": "Show/hide participants panel", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+U" }, "mac": { "type": "keys", "chord": "Cmd+U" } },
    { "name": "Open invite window", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+I" }, "mac": { "type": "keys", "chord": "Cmd+I" } },
    { "name": "Copy invitation link", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+I" }, "mac": { "type": "keys", "chord": "Cmd+Shift+I" } },
    { "name": "Raise/lower hand", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Y" }, "mac": { "type": "keys", "chord": "Alt+Y" } },
    { "name": "Display prompt to end or leave meeting", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Q" } },
    { "name": "Begin remote control", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+R" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+R" } },
    { "name": "Revoke/give up remote control permission", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+G" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+G" } },
    { "name": "Read active speaker name", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+2" }, "mac": { "type": "keys", "chord": "Cmd+2" } },
    { "name": "Show/hide floating meeting controls", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+Alt+Shift+H" }, "mac": { "type": "keys", "chord": "Ctrl+Alt+Cmd+H" } },
    { "name": "Toggle Always show meeting controls", "context": "In a meeting", "mac": { "type": "keys", "chord": "Ctrl+\\" } },
    { "name": "Enable/disable dual monitor mode", "context": "In a meeting", "mac": { "type": "keys", "chord": "Cmd+Shift+D" } },
    { "name": "Focus input field in chat window", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+E" }, "mac": { "type": "keys", "chord": "Cmd+Shift+E" } },
    { "name": "Focus last received parent message in chat history", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+Shift+U" }, "mac": { "type": "keys", "chord": "Cmd+Shift+U" } },
    { "name": "Focus list of chats", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+L" } },
    { "name": "Jump to start of unread messages in chat", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+Shift+N" } },
    { "name": "Start new chat with meeting participants", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+N" }, "mac": { "type": "keys", "chord": "Cmd+N" } },
    { "name": "Open the AI chat panel in a meeting", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+Shift+O" }, "mac": { "type": "keys", "chord": "Cmd+Shift+O" } },
    { "name": "Open Reactions panel", "context": "In a meeting", "windows": { "type": "keys", "chord": "Ctrl+Shift+Y" }, "mac": { "type": "keys", "chord": "Cmd+Shift+Y" } },
    { "name": "Send clap reaction", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+4" }, "mac": { "type": "keys", "chord": "Alt+Cmd+4" } },
    { "name": "Send thumbs up reaction", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+5" }, "mac": { "type": "keys", "chord": "Alt+Cmd+5" } },
    { "name": "Send heart reaction", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+6" }, "mac": { "type": "keys", "chord": "Alt+Cmd+6" } },
    { "name": "Send joy reaction", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+7" }, "mac": { "type": "keys", "chord": "Alt+Cmd+7" } },
    { "name": "Send open mouth reaction", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+8" }, "mac": { "type": "keys", "chord": "Alt+Cmd+8" } },
    { "name": "Send tada reaction", "context": "In a meeting", "windows": { "type": "keys", "chord": "Alt+Shift+9" }, "mac": { "type": "keys", "chord": "Alt+Cmd+9" } },

    { "name": "Screenshot", "context": "Chat", "windows": { "type": "keys", "chord": "Alt+Shift+T" }, "mac": { "type": "keys", "chord": "Cmd+T" } },
    { "name": "Hide current chat session", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+W" } },
    { "name": "Go to previous chat", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+Up" } },
    { "name": "Go to next chat", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+Down" } },
    { "name": "Back in chat history", "context": "Chat", "windows": { "type": "keys", "chord": "Alt+Left" }, "mac": { "type": "keys", "chord": "Cmd+[" } },
    { "name": "Forward in chat history", "context": "Chat", "windows": { "type": "keys", "chord": "Alt+Right" }, "mac": { "type": "keys", "chord": "Cmd+]" } },
    { "name": "Start a new chat", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+N" }, "mac": { "type": "keys", "chord": "Cmd+N" } },
    { "name": "Focus to list of all chats and channels", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+L" }, "mac": { "type": "keys", "chord": "Cmd+Shift+L" } },
    { "name": "Focus keyboard to latest message in current group chat or channel", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+Shift+U" }, "mac": { "type": "keys", "chord": "Cmd+Shift+U" } },
    { "name": "Add member to current group chat or channel", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+Alt+I" }, "mac": { "type": "keys", "chord": "Cmd+Alt+I" } },
    { "name": "Jump to start of new messages in current group chat or channel", "context": "Chat", "windows": { "type": "keys", "chord": "Alt+N" }, "mac": { "type": "keys", "chord": "Cmd+Ctrl+N" } },
    { "name": "Insert a hyperlink", "context": "Chat", "windows": { "type": "keys", "chord": "Ctrl+K" } },
    { "name": "Collapse all", "context": "Chat", "mac": { "type": "keys", "chord": "Alt+Cmd+0" } },
    { "name": "Search in chat or channel", "context": "Chat", "mac": { "type": "keys", "chord": "Cmd+F" } },

    { "name": "Record new clip", "context": "Clips", "mac": { "type": "keys", "chord": "Shift+Cmd+C" } },

    { "name": "Call highlighted phone number", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+P" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+C" } },
    { "name": "Accept inbound call", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+Shift+A" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+A" } },
    { "name": "Decline inbound call", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+Shift+D" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+D" } },
    { "name": "End the current call", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+Shift+E" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+E" } },
    { "name": "Mute/unmute call", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+Shift+M" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+M" } },
    { "name": "Hold/unhold call", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+Shift+H" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+H" } },
    { "name": "Transfer call", "context": "Phone", "windows": { "type": "keys", "chord": "Ctrl+Shift+T" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+T" } },

    { "name": "Open the AI chat panel", "context": "", "windows": { "type": "keys", "chord": "Ctrl+Shift+O" }, "mac": { "type": "keys", "chord": "Shift+Cmd+O" } },
    { "name": "Open the Calendar panel", "context": "", "windows": { "type": "keys", "chord": "Ctrl+Shift+J" }, "mac": { "type": "keys", "chord": "Shift+Cmd+J" } },
    { "name": "Close current window", "context": "", "windows": { "type": "keys", "chord": "Alt+F4" }, "mac": { "type": "keys", "chord": "Cmd+W" } },
    { "name": "Search", "context": "", "windows": { "type": "keys", "chord": "Ctrl+F" } },
    { "name": "Global search", "context": "", "mac": { "type": "keys", "chord": "Cmd+E" } },
    { "name": "Navigate among Zoom popup windows", "context": "", "windows": { "type": "keys", "chord": "F6" } },
    { "name": "Switch to next product tab", "context": "", "windows": { "type": "keys", "chord": "Ctrl+Tab" }, "mac": { "type": "keys", "chord": "Ctrl+Tab" } },
    { "name": "Switch to previous product tab", "context": "", "windows": { "type": "keys", "chord": "Ctrl+Shift+Tab" }, "mac": { "type": "keys", "chord": "Ctrl+Shift+Tab" } },
    { "name": "Switch to last product tab", "context": "", "windows": { "type": "keys", "chord": "Ctrl+9" }, "mac": { "type": "keys", "chord": "Cmd+9" } },
    { "name": "Switch between Portrait and Landscape views", "context": "", "windows": { "type": "keys", "chord": "Alt+L" }, "mac": { "type": "keys", "chord": "Cmd+L" } },
    { "name": "Start network diagnostic", "context": "", "windows": { "type": "keys", "chord": "Ctrl+Alt+Shift+D" } },
    { "name": "Increase chat display size", "context": "", "windows": { "type": "keys", "chord": "Ctrl+Plus" }, "mac": { "type": "keys", "chord": "Cmd+Plus" } },
    { "name": "Decrease chat display size", "context": "", "windows": { "type": "keys", "chord": "Ctrl+-" }, "mac": { "type": "keys", "chord": "Cmd+-" } },
    { "name": "Reset chat display size", "context": "", "mac": { "type": "keys", "chord": "Cmd+0" } },
    { "name": "Start Zoom Client Healthcheck", "context": "", "mac": { "type": "keys", "chord": "Cmd+Alt+Shift+D" } },
    { "name": "Share Log", "context": "", "mac": { "type": "keys", "chord": "Ctrl+Alt+Shift+V" } }
