  "defaults": {
    "TUNE_TAP_1F": { "name": "Mute/unmute audio", "action": { "type": "keys", "chord": "Alt+A" } },
    "TUNE_SWIPE_UP": { "name": "Start/stop video", "action": { "type": "keys", "chord": "Alt+V" } }
