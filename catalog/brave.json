      "context": "Address bar",
      "windows": {
        "type": "sequence",
        "chords": [
          "Down",
          "Shift+Delete"
        ]
      },
      "mac": {
        "type": "sequence",
        "chords": [
          "Down",
          "Shift+Delete"
        ]
      }
    },
    {
      "name": "Open options to print the current page",
      "context": "Webpage",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+P"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+P"
      }
