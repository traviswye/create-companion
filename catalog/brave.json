  "defaults": {
    "TUNE_CW": {
      "name": "Jump to the next open tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      },
      "accel": "light"
    },
    "TUNE_CCW": {
      "name": "Jump to the previous open tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      },
      "accel": "light"
    },
    "TUNE_TAP_1F": {
      "name": "Open a new tab, and jump to it",
      "action": {
        "type": "keys",
        "chord": "Ctrl+T"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Open the previous page from your browsing history",
      "action": {
        "type": "keys",
        "chord": "Alt+Left"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Open the next page from your browsing history",
      "action": {
        "type": "keys",
        "chord": "Alt+Right"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Make everything on the page bigger (zoom in)",
      "action": {
        "type": "keys",
        "chord": "Ctrl+="
      }
    },
    "TUNE_SWIPE_DOWN": {
