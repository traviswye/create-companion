{
  "id": "brave",
  "name": "Brave",
  "kind": "app",
  "category": "Browser",
  "match": {
    "windows_exe": [
      "brave.exe"
    ],
    "macos_bundle": [
      "com.brave.Browser"
    ],
    "window_title": []
  },
  "sources": [
    "https://support.brave.app/hc/en-us/articles/360032272171-What-keyboard-shortcuts-can-I-use-in-Brave"
  ],
  "note": "From Brave's Help Center article \"What keyboard shortcuts can I use in Brave?\", which is itself Brave's own restatement of the Chromium shortcut set it inherits (same sections and near-identical wording to Chromium/Google Chrome's official list, just relabelled for Brave: \"Brave Task Manager\", \"Brave Help Center\", \"Quit Brave\"). Where the vendor lists multiple alternate chords for one action, only the primary chord is recorded. \"Ctrl+1 through Ctrl+8\" is expanded into 8 explicit tab-jump actions. Skipped as not expressible: the Mouse section (drag-and-drop, click/right-click combinations, mouse-wheel zoom).",
  "actions": [
    {
      "name": "Open a new window",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+N"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+N"
      }
    },
    {
      "name": "Open a new window in Private mode",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+N"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+N"
      }
    },
    {
      "name": "Open a new tab, and jump to it",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+T"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+T"
      }
    },
    {
      "name": "Reopen the last closed tab, and jump to it",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+T"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+T"
      }
    },
    {
      "name": "Jump to the next open tab",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Alt+Right"
      }
    },
    {
      "name": "Jump to the previous open tab",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Alt+Left"
      }
    },
    {
      "name": "Jump to tab 1",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+1"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+1"
      }
    },
    {
      "name": "Jump to tab 2",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+2"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+2"
      }
    },
    {
      "name": "Jump to tab 3",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+3"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+3"
      }
    },
    {
      "name": "Jump to tab 4",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+4"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+4"
      }
    },
    {
      "name": "Jump to tab 5",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+5"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+5"
      }
    },
    {
      "name": "Jump to tab 6",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+6"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+6"
      }
    },
    {
      "name": "Jump to tab 7",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+7"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+7"
      }
    },
    {
      "name": "Jump to tab 8",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+8"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+8"
      }
    },
    {
      "name": "Jump to the last tab",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+9"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+9"
      }
    },
    {
      "name": "Open your home page in the current tab",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Alt+Home"
      }
    },
    {
