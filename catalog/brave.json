      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Alt+Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Left"
      }
    },
    {
      "name": "Open the next page from your browsing history",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Alt+Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Right"
      }
    },
    {
      "name": "Close the current tab",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+W"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+W"
      }
    },
    {
      "name": "Close the current window",
      "context": "Tabs and Windows",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+W"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+W"
      }
    },
    {
      "name": "Minimize the current window",
      "context": "Tabs and Windows",
      "windows": {
        "type": "sequence",
        "chords": [
          "Alt+Space",
          "N"
        ]
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+M"
      }
    },
