      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Delete"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+Delete"
      }
    },
    {
      "name": "Open the Brave Help Center in a new tab",
      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "F1"
      }
    },
