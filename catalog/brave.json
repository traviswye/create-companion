        "type": "keys",
        "chord": "Ctrl+Shift+M"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+M"
      }
    },
    {
      "name": "Add www. and .com to a site name, and open it in the current tab",
      "context": "Address bar",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Enter"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Enter"
      }
    },
    {
      "name": "Add www. and .com to a site name, and open it in a new tab",
      "context": "Address bar",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Enter"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Shift+Enter"
      }
    },
    {
      "name": "Open the typed website in a new background tab",
      "context": "Address bar",
      "mac": {
        "type": "keys",
        "chord": "Cmd+Enter"
      }
    },
    {
      "name": "Jump to the address bar",
      "context": "Address bar",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+L"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+L"
      }
    },
    {
      "name": "Search from anywhere on the page",
      "context": "Address bar",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+K"
      }
    },
    {
