      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+B"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+B"
      }
    },
    {
      "name": "Open the Bookmarks Manager",
      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+O"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Alt+B"
      }
    },
    {
      "name": "Open the Settings page in a new tab",
      "context": "Browser",
      "mac": {
        "type": "keys",
        "chord": "Cmd+,"
      }
    },
    {
      "name": "Open the History page in a new tab",
      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+H"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Y"
      }
    },
    {
      "name": "Open the Downloads page in a new tab",
      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+J"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+J"
      }
    },
    {
      "name": "Open the Brave Task Manager",
      "context": "Browser",
      "windows": {
        "type": "keys",
        "chord": "Shift+Esc"
      }
    },
    {
