      "action": {
        "type": "keys",
        "chord": "Alt+Left"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Go forward",
      "action": {
        "type": "keys",
        "chord": "Alt+Right"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Previous problem",
      "action": {
        "type": "keys",
        "chord": "Shift+F8"
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Next problem",
      "action": {
        "type": "keys",
        "chord": "F8"
      }
