{
  "id": "blender",
  "name": "Blender",
  "kind": "app",
  "category": "CAD / 3D",
  "match": {
    "windows_exe": [
      "blender.exe"
    ],
    "macos_bundle": [
      "org.blenderfoundation.blender"
    ],
    "window_title": []
  },
  "sources": [],
  "note": "hand-authored 2026-09-04; expand from official documentation",
  "actions": [
    {
      "name": "Next frame",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Right"
      }
    },
    {
      "name": "Previous frame",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Left"
      }
    },
    {
      "name": "Play animation",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Space"
      },
      "mac": {
        "type": "keys",
        "chord": "Space"
      }
    },
    {
      "name": "Undo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    {
      "name": "Redo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      }
    },
    {
      "name": "Jump to next keyframe",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Up"
      },
      "mac": {
        "type": "keys",
        "chord": "Up"
      }
    },
    {
      "name": "Jump to previous keyframe",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Down"
      },
      "mac": {
        "type": "keys",
        "chord": "Down"
      }
    }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Next frame",
      "action": {
        "type": "keys",
        "chord": "Right"
      },
      "accel": "medium"
    },
    "TUNE_CCW": {
      "name": "Previous frame",
      "action": {
        "type": "keys",
        "chord": "Left"
      },
      "accel": "medium"
    },
    "TUNE_TAP_1F": {
      "name": "Play animation",
      "action": {
        "type": "keys",
        "chord": "Space"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Undo",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Redo",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Jump to next keyframe",
      "action": {
        "type": "keys",
        "chord": "Up"
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Jump to previous keyframe",
      "action": {
        "type": "keys",
        "chord": "Down"
      }
    }
  }
}
