    { "name": "Go to your Merge requests page", "context": "", "windows": { "type": "keys", "chord": "Shift+M" }, "mac": { "type": "keys", "chord": "Shift+M" } },
    { "name": "Go to your Review requests page", "context": "", "windows": { "type": "keys", "chord": "Shift+R" }, "mac": { "type": "keys", "chord": "Shift+R" } },
