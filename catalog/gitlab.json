    { "name": "Go to your Milestones page", "context": "", "windows": { "type": "keys", "chord": "Shift+L" }, "mac": { "type": "keys", "chord": "Shift+L" } },
    { "name": "Go to your Snippets page", "context": "", "windows": { "type": "keys", "chord": "Shift+S" }, "mac": { "type": "keys", "chord": "Shift+S" } },
