{
  "id": "disney_plus",
  "name": "Disney+",
  "kind": "site",
  "category": "Video",
  "match": {
    "windows_exe": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "brave.exe",
      "vivaldi.exe"
    ],
    "macos_bundle": [
      "com.google.Chrome",
      "com.microsoft.edgemac",
      "org.mozilla.firefox",
      "com.brave.Browser",
      "com.apple.Safari"
    ],
    "window_title": [
      "Disney+"
    ]
  },
  "sources": [
    "https://help.disneyplus.com/article/disneyplus-accessibility#keyboard"
  ],
  "note": "\"Keyboard navigation\" section of the Help Center article \"Accessibility features on Disney+\", covering DisneyPlus.com. Not expressible, so left out: none.",
  "actions": [
    { "name": "Navigate to next content, button, or link", "context": "", "windows": { "type": "keys", "chord": "Tab" }, "mac": { "type": "keys", "chord": "Tab" } },
    { "name": "Navigate to previous content, button, or link", "context": "", "windows": { "type": "keys", "chord": "Shift+Tab" }, "mac": { "type": "keys", "chord": "Shift+Tab" } },
    { "name": "Select content, button, or link", "context": "", "windows": { "type": "keys", "chord": "Enter" }, "mac": { "type": "keys", "chord": "Enter" } },
    { "name": "Scroll up on the page", "context": "", "windows": { "type": "keys", "chord": "Up" }, "mac": { "type": "keys", "chord": "Up" } },
    { "name": "Scroll down on the page", "context": "", "windows": { "type": "keys", "chord": "Down" }, "mac": { "type": "keys", "chord": "Down" } },
    { "name": "Jump to the next section of the page", "context": "", "windows": { "type": "keys", "chord": "Space" }, "mac": { "type": "keys", "chord": "Space" } },
    { "name": "Play/Pause", "context": "Playback", "windows": { "type": "keys", "chord": "Space" }, "mac": { "type": "keys", "chord": "Space" } },
    { "name": "Rewind 10 seconds", "context": "Playback", "windows": { "type": "keys", "chord": "Left" }, "mac": { "type": "keys", "chord": "Left" } },
    { "name": "Fast Forward 10 seconds", "context": "Playback", "windows": { "type": "keys", "chord": "Right" }, "mac": { "type": "keys", "chord": "Right" } },
    { "name": "Raise volume by 10%", "context": "Playback", "windows": { "type": "keys", "chord": "Up" }, "mac": { "type": "keys", "chord": "Up" } },
    { "name": "Lower volume by 10%", "context": "Playback", "windows": { "type": "keys", "chord": "Down" }, "mac": { "type": "keys", "chord": "Down" } },
    { "name": "Enter fullscreen", "context": "Playback", "windows": { "type": "keys", "chord": "F" }, "mac": { "type": "keys", "chord": "F" } },
    { "name": "Exit fullscreen", "context": "Playback", "windows": { "type": "keys", "chord": "Esc" }, "mac": { "type": "keys", "chord": "Esc" } },
    { "name": "Mute/Unmute", "context": "Playback", "windows": { "type": "keys", "chord": "M" }, "mac": { "type": "keys", "chord": "M" } },
    { "name": "Skip intro/Skip recap", "context": "Playback", "windows": { "type": "keys", "chord": "S" }, "mac": { "type": "keys", "chord": "S" } }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Fast Forward 10 seconds",
      "action": { "type": "keys", "chord": "Right" },
      "accel": "medium"
    },
    "TUNE_CCW": {
      "name": "Rewind 10 seconds",
      "action": { "type": "keys", "chord": "Left" },
      "accel": "medium"
    },
    "TUNE_TAP_1F": {
      "name": "Play/Pause",
      "action": { "type": "keys", "chord": "Space" }
    },
    "TUNE_SWIPE_UP": {
      "name": "Raise volume by 10%",
      "action": { "type": "keys", "chord": "Up" }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Lower volume by 10%",
      "action": { "type": "keys", "chord": "Down" }
    }
  }
}
