      "name": "Go to navigation panel (folders list)",
      "context": "",
      "windows": {
        "type": "sequence",
        "chords": [
          "Alt+G",
          "N"
        ]
      },
      "mac": {
        "type": "sequence",
        "chords": [
          "Alt+G",
          "N"
        ]
      }
    },
