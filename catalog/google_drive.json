{
  "id": "google_drive",
  "name": "Google Drive",
  "kind": "site",
  "category": "Files",
  "match": {
    "windows_exe": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "brave.exe",
      "vivaldi.exe"
    ],
    "macos_bundle": [
      "com.google.Chrome",
      "com.microsoft.edgemac",
      "org.mozilla.firefox",
      "com.brave.Browser",
      "com.apple.Safari"
    ],
    "window_title": [
      "Google Drive"
    ]
  },
  "sources": [
    "https://support.google.com/drive/answer/2563044?hl=en&co=GENIE.Platform%3DDesktop"
  ],
  "note": "Google Drive on the web, current UI. Two-key navigation shortcuts (e.g. 'g then n') are modeled as sequences; where the vendor's Mac column literally shows 'control' rather than 'command' for a chord (the create/upload menu family), that is kept as documented. First-letter-of-filename navigation and drag-and-drop / mouse-modifier shortcuts are omitted.",
