{
  "id": "musicbee",
  "name": "MusicBee",
  "kind": "app",
  "category": "Music",
  "match": {
    "windows_exe": [
      "MusicBee.exe"
    ],
    "macos_bundle": [],
    "window_title": []
  },
  "sources": [
    "https://musicbee.fandom.com/wiki/Hotkeys"
  ],
  "note": "Windows only; there is no official macOS build. MusicBee offers 150+ assignable hotkey commands, but only the ones listed here are bound by default on install (per the wiki, up-to-date with MusicBee 3.0.5903); the rest are unbound until the user assigns them in Preferences > Hotkeys, so they are not listed, matching the convention used for Obsidian's unbound commands. 'Global' context means the hotkey fires even when MusicBee is not the focused window. Skipped as not expressible: 'Multimedia: Stop' (no generic media-stop key in this grammar's media key set), and the eight half-star rating adjustments ('0.5 stars Up/Down' for both Now Playing and Selected Tracks) which are bound to the numpad NumPlus/NumMinus keys, not expressible per the chord grammar.",
  "actions": [
    {
      "name": "Edit: Amend Clicked Column",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "F2"
      }
    },
    {
      "name": "Edit: Configure MusicBee Preferences",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+O"
