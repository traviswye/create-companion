{
  "id": "premiere",
  "name": "Adobe Premiere Pro",
  "kind": "app",
  "category": "Video",
  "match": {
    "windows_exe": [
      "Adobe Premiere Pro.exe"
    ],
    "macos_bundle": [
      "com.adobe.PremierePro.CC"
    ],
    "window_title": []
  },
  "sources": [],
  "note": "hand-authored 2026-09-04; expand from official documentation",
  "actions": [
    {
      "name": "Step forward one frame",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Right"
      }
    },
    {
      "name": "Step back one frame",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Left"
      }
    },
    {
      "name": "Play / stop",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Space"
      },
      "mac": {
        "type": "keys",
        "chord": "Space"
      }
    },
    {
      "name": "Step back five frames",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+Left"
      }
    },
    {
      "name": "Step forward five frames",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+Right"
      }
    },
    {
      "name": "Zoom in timeline",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "="
      },
      "mac": {
        "type": "keys",
        "chord": "="
      }
    },
    {
      "name": "Zoom out timeline",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "-"
      },
      "mac": {
        "type": "keys",
        "chord": "-"
      }
    },
    {
      "name": "Add marker",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "M"
      },
      "mac": {
        "type": "keys",
        "chord": "M"
      }
    },
    {
      "name": "Ripple delete",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+Delete"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+Delete"
      }
    },
    {
      "name": "Razor at playhead",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+K"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+K"
      }
    },
    {
      "name": "Go to in point",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+I"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+I"
      }
    },
    {
      "name": "Go to out point",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+O"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+O"
      }
    },
    {
      "name": "Undo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    {
      "name": "Redo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      }
    }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Step forward one frame",
      "action": {
        "type": "keys",
        "chord": "Right"
      },
      "accel": "medium"
    },
    "TUNE_CCW": {
      "name": "Step back one frame",
      "action": {
        "type": "keys",
        "chord": "Left"
      },
      "accel": "medium"
    },
    "TUNE_TAP_1F": {
      "name": "Play / stop",
      "action": {
        "type": "keys",
        "chord": "Space"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Step back five frames",
      "action": {
        "type": "keys",
        "chord": "Shift+Left"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Step forward five frames",
      "action": {
        "type": "keys",
        "chord": "Shift+Right"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Zoom in timeline",
      "action": {
        "type": "keys",
        "chord": "="
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Zoom out timeline",
      "action": {
        "type": "keys",
        "chord": "-"
      }
    }
  }
}
