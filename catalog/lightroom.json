{
  "id": "lightroom",
  "name": "Adobe Lightroom",
  "kind": "app",
  "category": "Creative",
  "match": {
    "windows_exe": [
      "Lightroom.exe",
      "LightroomClassic.exe"
    ],
    "macos_bundle": [
      "com.adobe.LightroomClassicCC7",
      "com.adobe.lightroomCC"
    ],
    "window_title": []
  },
  "sources": [
    "https://github.com/waldobronchart/ShortcutMapper"
  ],
  "note": "Default bindings hand-authored 2026-09-04; the full shortcut list comes from the ShortcutMapper import in reference/app-shortcuts.json",
  "actions": [
    {
      "name": "Next Photo in Filmstrip",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Right"
      }
    },
    {
      "name": "Previous Photo in Filmstrip",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Left"
      }
    },
    {
      "name": "Toggle Zoom View",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Z"
      }
    },
    {
      "name": "Undo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    {
      "name": "Redo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Y"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Y"
      }
    },
    {
      "name": "Flag as pick",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "P"
      },
      "mac": {
        "type": "keys",
        "chord": "P"
      }
    },
    {
      "name": "Flag as reject",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "X"
      },
      "mac": {
        "type": "keys",
        "chord": "X"
      }
    }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Next Photo in Filmstrip",
      "action": {
        "type": "keys",
        "chord": "Right"
      }
    },
    "TUNE_CCW": {
      "name": "Previous Photo in Filmstrip",
      "action": {
        "type": "keys",
        "chord": "Left"
      }
    },
    "TUNE_TAP_1F": {
      "name": "Toggle Zoom View",
      "action": {
        "type": "keys",
        "chord": "Z"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Undo",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Redo",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Y"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Flag as pick",
      "action": {
        "type": "keys",
        "chord": "P"
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Flag as reject",
      "action": {
        "type": "keys",
        "chord": "X"
      }
    }
  }
}
