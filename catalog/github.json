{
  "id": "github",
  "name": "GitHub",
  "kind": "site",
  "category": "Development",
  "match": {
    "windows_exe": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "brave.exe",
      "vivaldi.exe"
    ],
    "macos_bundle": [
      "com.google.Chrome",
      "com.microsoft.edgemac",
      "org.mozilla.firefox",
      "com.brave.Browser",
      "com.apple.Safari"
    ],
    "window_title": [
      "GitHub"
    ]
  },
  "sources": [
    "https://docs.github.com/en/get-started/accessibility/keyboard-shortcuts",
    "https://docs.github.com/en/get-started/accessibility/github-command-palette"
  ],
  "note": "Extracted from GitHub Docs 'Keyboard shortcuts' (17 sections) and 'GitHub Command Palette' pages, 2026-09-04. Where a shortcut was documented with two interchangeable forms ('S or /', 'O or Enter', 'Shift+T or T', 'Shift+F or F', arrow keys or H/J/K/L in Network graph), only the first/primary form is listed. Two shortcuts written as a bare punctuation character not in the chord grammar ('>' to open github.dev/command mode in a new tab) are represented by their physical key equivalent 'Shift+.'. Skipped as not expressible by the chord grammar: mouse-only shortcuts (Alt/Shift/Ctrl+Shift + click, click-then-shift-click), the generic 'use arrow keys to highlight results' entries in the command palette, the '#', '!', '@', '?' single-character command-palette triggers (punctuation not in the allowed key set), and 'Ctrl+. then Ctrl+[saved reply number]' (the second chord has no fixed key). 'Toggle between Edit file and Preview changes tabs' in Source code editing is documented Mac-only (Cmd+Shift+P) with no Windows/Linux form given, so only mac is listed for that one action.",
  "actions": [
    {
      "name": "Focus the search bar",
      "context": "",
      "windows": { "type": "keys", "chord": "S" },
      "mac": { "type": "keys", "chord": "S" }
    },
    {
      "name": "Go to your notifications",
      "context": "",
      "windows": { "type": "sequence", "chords": ["G", "N"] },
      "mac": { "type": "sequence", "chords": ["G", "N"] }
    },
    {
      "name": "Move focus from an element to its hovercard",
      "context": "",
      "windows": { "type": "keys", "chord": "Alt+Up" },
      "mac": { "type": "keys", "chord": "Alt+Up" }
    },
    {
      "name": "Close hovercard and refocus on the element",
      "context": "",
      "windows": { "type": "keys", "chord": "Esc" },
      "mac": { "type": "keys", "chord": "Esc" }
    },
    {
      "name": "Go to the Code tab",
      "context": "Repositories",
      "windows": { "type": "sequence", "chords": ["G", "C"] },
      "mac": { "type": "sequence", "chords": ["G", "C"] }
    },
    {
      "name": "Go to the Issues tab",
      "context": "Repositories",
      "windows": { "type": "sequence", "chords": ["G", "I"] },
      "mac": { "type": "sequence", "chords": ["G", "I"] }
    },
    {
      "name": "Go to the Pull requests tab",
      "context": "Repositories",
