      "name": "Go to the Actions tab",
      "context": "Repositories",
      "windows": { "type": "sequence", "chords": ["G", "A"] },
      "mac": { "type": "sequence", "chords": ["G", "A"] }
    },
    {
      "name": "Go to the Wiki tab",
      "context": "Repositories",
      "windows": { "type": "sequence", "chords": ["G", "W"] },
      "mac": { "type": "sequence", "chords": ["G", "W"] }
    },
    {
      "name": "Go to the Discussions tab",
      "context": "Repositories",
