{
  "id": "apple_music",
  "name": "Apple Music",
  "kind": "app",
  "category": "Music",
  "match": {
    "windows_exe": [
      "AppleMusic.exe",
      "iTunes.exe"
    ],
    "macos_bundle": [
      "com.apple.Music"
    ],
    "window_title": []
  },
  "sources": [
    "https://support.apple.com/guide/music/keyboard-shortcuts-mus1019/mac",
    "https://support.apple.com/guide/music-windows/keyboard-shortcuts-mus1019/windows"
  ],
  "note": "Windows access keys are documented as sequential Alt-mnemonic presses (Alt, then two letters, one after another). They are encoded here as a sequence whose first chord holds Alt with the first letter and whose second chord is the bare second letter, since the chord grammar has no way to express a standalone modifier tap. 'Select or deselect all the songs in a list' (Command-click a checkbox), 'Switch between custom and maximum window sizes' (Option-click the green button), 'Change the song information columns' (Control-click a column heading), and 'Initiate a search in the iTunes Store' (type text, then press Option-Return) require a mouse click or free text entry and are not included. 'See more options when a visual effect is showing' (press ? then a shown key) is not a fixed chord and is omitted. 'Open Apple Music Help menu' on Mac is Command-? (Command-Shift-/), which the chord grammar cannot express since ? is not an allowed key, so only the Windows F1 binding is included for that action.",
  "actions": [
    {
      "name": "Play or pause the selected song",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Space"
      },
      "mac": {
        "type": "keys",
        "chord": "Space"
      }
    },
    {
      "name": "Play the currently selected song from the beginning",
      "context": "",
      "mac": {
        "type": "keys",
        "chord": "Enter"
      }
    },
    {
      "name": "Move forward within a song",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Alt+Ctrl+Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Alt+Cmd+Right"
      }
    },
    {
      "name": "Move backward within a song",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Alt+Ctrl+Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Alt+Cmd+Left"
      }
    },
    {
      "name": "Stop playing the selected song",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+."
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+."
      }
    },
    {
