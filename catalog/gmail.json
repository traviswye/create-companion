{
  "id": "gmail",
  "name": "Gmail",
  "kind": "site",
  "category": "Communication",
  "match": {
    "windows_exe": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "brave.exe",
      "vivaldi.exe"
    ],
    "macos_bundle": [
      "com.google.Chrome",
      "com.microsoft.edgemac",
      "org.mozilla.firefox",
      "com.brave.Browser",
      "com.apple.Safari"
    ],
    "window_title": [
      "Gmail"
    ]
  },
  "sources": [
    "https://support.google.com/mail/answer/6594?hl=en&co=GENIE.Platform%3DDesktop"
  ],
  "note": "Most shortcuts under Actions, Jumping, Threadlist Selection, Navigation and Application require Settings > General > Keyboard shortcuts: On. Compose/formatting shortcuts and 'Send' work regardless of that setting. Symbol keys not directly expressible in the chord grammar are written as their US-QWERTY Shift+digit/punctuation equivalent (e.g. '#' = Shift+3, '!' = Shift+1, '?' = Shift+/, '~' = Shift+`, '_' = Shift+-, ':' = Shift+;). Mouse-only shortcuts (drag to reorder, right-click menus) are omitted.",
