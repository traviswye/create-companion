{
  "id": "terminal",
  "name": "Terminal",
  "kind": "app",
  "category": "Development",
  "match": {
    "windows_exe": [
      "WindowsTerminal.exe",
      "powershell.exe",
      "pwsh.exe",
      "cmd.exe",
      "conhost.exe",
      "OpenConsole.exe"
    ],
    "macos_bundle": [
      "com.apple.Terminal",
      "com.googlecode.iterm2"
    ],
    "window_title": []
  },
  "sources": [
    "https://learn.microsoft.com/en-us/windows/terminal/customize-settings/actions"
  ],
  "note": "Windows Terminal only; the docs give no macOS bindings, so all actions are windows-only. Includes only commands that have an explicit default key binding on the actions page (many commands, e.g. closeTab, tabSearch, renameTab, moveTab, movePane, exportBuffer, are documented but unbound by default and are omitted). Where a command has multiple default bindings (e.g. Copy also on Ctrl+Shift+C/Ctrl+Insert/Enter, Paste also on Ctrl+Shift+V/Shift+Insert, font size also on the numpad +/- keys), only the primary binding is listed except where a second binding is independently well known (Toggle full screen also on F11).",
  "actions": [
    {
      "name": "Close window",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Alt+F4"
      }
    },
    {
      "name": "Find",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+F"
      }
    },
    {
      "name": "Open the dropdown",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Space"
      }
    },
    {
      "name": "Open settings UI",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+,"
      }
    },
    {
      "name": "Open settings file",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+,"
      }
    },
    {
      "name": "Open default settings file",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Alt+,"
