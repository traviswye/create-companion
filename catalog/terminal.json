  "defaults": {
    "TUNE_CW": {
      "name": "Newer command (history)",
      "action": {
        "type": "keys",
        "chord": "Down"
      }
    },
    "TUNE_CCW": {
      "name": "Older command (history)",
      "action": {
        "type": "keys",
        "chord": "Up"
      }
    },
    "TUNE_TAP_1F": {
      "name": "Clear line",
      "action": {
        "type": "keys",
        "chord": "Esc"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+U"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Previous tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+["
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Next tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+Shift+]"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Font bigger",
      "action": {
        "type": "keys",
        "chord": "Ctrl+="
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+="
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Font smaller",
      "action": {
        "type": "keys",
        "chord": "Ctrl+-"
      },
      "mac": {
        "type": "keys",
        "chord": "Cmd+-"
      }
    }
