{
  "id": "browser",
  "name": "Browser",
  "kind": "app",
  "category": "Browser",
  "match": {
    "windows_exe": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "brave.exe",
      "vivaldi.exe"
    ],
    "macos_bundle": [
      "com.google.Chrome",
      "com.microsoft.edgemac",
      "org.mozilla.firefox",
      "com.brave.Browser",
      "com.apple.Safari"
    ],
    "window_title": []
  },
  "sources": [
    "https://support.google.com/chrome/answer/157179"
  ],
  "note": "Combined browser profile used by the first-run config (Chromium-family chords). Per-browser entries chrome/edge/firefox/safari/brave/vivaldi carry the complete lists.",
  "actions": [
    {
      "name": "Next tab",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      }
    },
    {
      "name": "Previous tab",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      }
    },
    {
      "name": "New tab",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+T"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+T"
      }
    },
    {
      "name": "Back",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Alt+Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Alt+Left"
      }
    },
    {
      "name": "Forward",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Alt+Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Alt+Right"
      }
    },
    {
      "name": "Zoom in",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+="
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+="
      }
    },
    {
      "name": "Zoom out",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+-"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+-"
      }
    }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Next tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Tab"
      }
    },
    "TUNE_CCW": {
      "name": "Previous tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+Shift+Tab"
      }
    },
    "TUNE_TAP_1F": {
      "name": "New tab",
      "action": {
        "type": "keys",
        "chord": "Ctrl+T"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Back",
      "action": {
        "type": "keys",
        "chord": "Alt+Left"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Forward",
      "action": {
        "type": "keys",
        "chord": "Alt+Right"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Zoom in",
      "action": {
        "type": "keys",
        "chord": "Ctrl+="
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Zoom out",
      "action": {
        "type": "keys",
        "chord": "Ctrl+-"
      }
    }
  }
}
