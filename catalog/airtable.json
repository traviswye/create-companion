    { "name": "Jump to right edge of table", "context": "Grid view", "windows": { "type": "keys", "chord": "Ctrl+Right" }, "mac": { "type": "keys", "chord": "Cmd+Right" } },
    { "name": "Jump to top of table", "context": "Grid view", "windows": { "type": "keys", "chord": "Ctrl+Up" }, "mac": { "type": "keys", "chord": "Cmd+Up" } },
    { "name": "Jump to bottom of table", "context": "Grid view", "windows": { "type": "keys", "chord": "Ctrl+Down" }, "mac": { "type": "keys", "chord": "Cmd+Down" } },
