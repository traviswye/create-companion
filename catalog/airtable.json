    { "name": "Insert a record at the end of an unsorted or ungrouped view", "context": "Grid view", "windows": { "type": "keys", "chord": "Ctrl+Shift+Enter" }, "mac": { "type": "keys", "chord": "Cmd+Shift+Enter" } },
