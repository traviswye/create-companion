  "defaults": {
    "TUNE_CW": { "name": "Move focus to next element", "action": { "type": "keys", "chord": "Tab" }, "accel": "light" },
    "TUNE_CCW": { "name": "Move focus to previous element", "action": { "type": "keys", "chord": "Shift+Tab" }, "accel": "light" },
    "TUNE_TAP_1F": { "name": "Expand the active record", "action": { "type": "keys", "chord": "Space" } }
  }
