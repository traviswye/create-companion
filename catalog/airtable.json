    { "name": "Move record down", "context": "Grid view", "windows": { "type": "keys", "chord": "Alt+Down" }, "mac": { "type": "keys", "chord": "Alt+Down" } },
    { "name": "Open attachment upload window", "context": "Attachment field, Grid view", "windows": { "type": "keys", "chord": "Enter" }, "mac": { "type": "keys", "chord": "Enter" } },
    { "name": "Paste and upload attachment from clipboard", "context": "Attachment field, Grid view", "windows": { "type": "keys", "chord": "Ctrl+V" }, "mac": { "type": "keys", "chord": "Cmd+V" } },
    { "name": "Scroll to top of gallery", "context": "Gallery view", "windows": { "type": "keys", "chord": "Ctrl+Up" }, "mac": { "type": "keys", "chord": "Cmd+Up" } },
    { "name": "Scroll to bottom of gallery", "context": "Gallery view", "windows": { "type": "keys", "chord": "Ctrl+Down" }, "mac": { "type": "keys", "chord": "Cmd+Down" } },
    { "name": "Scroll to previous stack", "context": "Kanban view", "windows": { "type": "keys", "chord": "Left" }, "mac": { "type": "keys", "chord": "Left" } },
    { "name": "Scroll to next stack", "context": "Kanban view", "windows": { "type": "keys", "chord": "Right" }, "mac": { "type": "keys", "chord": "Right" } },
    { "name": "Scroll to first stack", "context": "Kanban view", "windows": { "type": "keys", "chord": "Ctrl+Left" }, "mac": { "type": "keys", "chord": "Cmd+Left" } },
    { "name": "Scroll to last stack", "context": "Kanban view", "windows": { "type": "keys", "chord": "Ctrl+Right" }, "mac": { "type": "keys", "chord": "Cmd+Right" } },
