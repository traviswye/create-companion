{
  "id": "evernote",
  "name": "Evernote",
  "kind": "app",
  "category": "Productivity",
  "match": {
    "windows_exe": [
      "Evernote.exe"
    ],
    "macos_bundle": [
      "com.evernote.Evernote"
    ]
