{
  "id": "resolve",
  "name": "DaVinci Resolve",
  "kind": "app",
  "category": "Video",
  "match": {
    "windows_exe": [
      "Resolve.exe"
    ],
    "macos_bundle": [
      "com.blackmagic-design.DaVinciResolve"
    ],
    "window_title": []
  },
  "sources": [],
  "note": "hand-authored 2026-09-04; expand from official documentation",
  "actions": [
    {
      "name": "Next frame",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Right"
      }
    },
    {
      "name": "Previous frame",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Left"
      }
    },
    {
      "name": "Play / stop",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Space"
      },
      "mac": {
        "type": "keys",
        "chord": "Space"
      }
    },
    {
      "name": "Back one second",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+Left"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+Left"
      }
    },
    {
      "name": "Forward one second",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Shift+Right"
      },
      "mac": {
        "type": "keys",
        "chord": "Shift+Right"
      }
    },
    {
      "name": "Zoom in timeline",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+="
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+="
      }
    },
    {
      "name": "Zoom out timeline",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+-"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+-"
      }
    },
    {
      "name": "Add marker",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "M"
      },
      "mac": {
        "type": "keys",
        "chord": "M"
      }
    },
    {
      "name": "Split clip",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+\\"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+\\"
      }
    },
    {
      "name": "Mark in",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "I"
      },
      "mac": {
        "type": "keys",
        "chord": "I"
      }
    },
    {
      "name": "Mark out",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "O"
      },
      "mac": {
        "type": "keys",
        "chord": "O"
      }
    },
    {
      "name": "Undo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Z"
      }
    },
    {
      "name": "Redo",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      },
      "mac": {
        "type": "keys",
        "chord": "Ctrl+Shift+Z"
      }
    },
    {
      "name": "Next edit",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Down"
      },
      "mac": {
        "type": "keys",
        "chord": "Down"
      }
    },
    {
      "name": "Previous edit",
      "context": "",
      "windows": {
        "type": "keys",
        "chord": "Up"
      },
      "mac": {
        "type": "keys",
        "chord": "Up"
      }
    }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Next frame",
      "action": {
        "type": "keys",
        "chord": "Right"
      },
      "accel": "medium"
    },
    "TUNE_CCW": {
      "name": "Previous frame",
      "action": {
        "type": "keys",
        "chord": "Left"
      },
      "accel": "medium"
    },
    "TUNE_TAP_1F": {
      "name": "Play / stop",
      "action": {
        "type": "keys",
        "chord": "Space"
      }
    },
    "TUNE_SWIPE_LEFT": {
      "name": "Back one second",
      "action": {
        "type": "keys",
        "chord": "Shift+Left"
      }
    },
    "TUNE_SWIPE_RIGHT": {
      "name": "Forward one second",
      "action": {
        "type": "keys",
        "chord": "Shift+Right"
      }
    },
    "TUNE_SWIPE_UP": {
      "name": "Zoom in timeline",
      "action": {
        "type": "keys",
        "chord": "Ctrl+="
      }
    },
    "TUNE_SWIPE_DOWN": {
      "name": "Zoom out timeline",
      "action": {
        "type": "keys",
        "chord": "Ctrl+-"
      }
    }
  }
}
