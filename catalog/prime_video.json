{
  "id": "prime_video",
  "name": "Prime Video",
  "kind": "site",
  "category": "Video",
  "match": {
    "windows_exe": [
      "chrome.exe",
      "msedge.exe",
      "firefox.exe",
      "brave.exe",
      "vivaldi.exe"
    ],
    "macos_bundle": [
      "com.google.Chrome",
      "com.microsoft.edgemac",
      "org.mozilla.firefox",
      "com.brave.Browser",
      "com.apple.Safari"
    ],
    "window_title": [
      "Prime Video"
    ]
  },
  "sources": [
    "https://www.amazon.com/gp/help/customer/display.html?nodeId=GH5GWCRVQCKEEFM8"
  ],
  "note": "From the Amazon Customer Service article \"Keyboard Shortcuts on Prime Video\", which covers Prime Video on a web browser (and the Windows/macOS apps). The article notes that on macOS the full-screen shortcut is the FN key plus F rather than F alone; Fn is not a supported modifier in this catalog's chord grammar, so F is used for both platforms and the FN nuance is called out here instead. Not expressible, so left out: none.",
  "actions": [
    { "name": "Toggle play/pause", "context": "", "windows": { "type": "keys", "chord": "Space" }, "mac": { "type": "keys", "chord": "Space" } },
    { "name": "Enter or exit full screen", "context": "", "windows": { "type": "keys", "chord": "F" }, "mac": { "type": "keys", "chord": "F" } },
    { "name": "Exit full screen or exit playback", "context": "", "windows": { "type": "keys", "chord": "Esc" }, "mac": { "type": "keys", "chord": "Esc" } },
    { "name": "Rewind 10 seconds", "context": "", "windows": { "type": "keys", "chord": "Left" }, "mac": { "type": "keys", "chord": "Left" } },
    { "name": "Fast-forward 10 seconds", "context": "", "windows": { "type": "keys", "chord": "Right" }, "mac": { "type": "keys", "chord": "Right" } },
    { "name": "Increase volume", "context": "", "windows": { "type": "keys", "chord": "Up" }, "mac": { "type": "keys", "chord": "Up" } },
    { "name": "Decrease volume", "context": "", "windows": { "type": "keys", "chord": "Down" }, "mac": { "type": "keys", "chord": "Down" } },
    { "name": "Toggle mute", "context": "", "windows": { "type": "keys", "chord": "M" }, "mac": { "type": "keys", "chord": "M" } },
    { "name": "Toggle subtitles/captions and cycle languages", "context": "", "windows": { "type": "keys", "chord": "C" }, "mac": { "type": "keys", "chord": "C" } },
    { "name": "Cycle audio tracks (including audio descriptions and Dialogue Boost)", "context": "", "windows": { "type": "keys", "chord": "A" }, "mac": { "type": "keys", "chord": "A" } }
  ],
  "defaults": {
    "TUNE_CW": {
      "name": "Fast-forward 10 seconds",
      "action": { "type": "keys", "chord": "Right" },
      "accel": "medium"
    },
    "TUNE_CCW": {
      "name": "Rewind 10 seconds",
      "action": { "type": "keys", "chord": "Left" },
      "accel": "medium"
    },
    "TUNE_TAP_1F": {
      "name": "Toggle play/pause",
      "action": { "type": "keys", "chord": "Space" }
    }
  }
}
